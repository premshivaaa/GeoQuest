generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String?  // empty for OAuth-only accounts
  avatar    String   @default("https://api.dicebear.com/7.x/bottts/svg?seed=default")
  role      String   @default("USER") // USER or ADMIN
  
  // Game Stats
  level     Int      @default(1)
  xp        Int      @default(0)
  coins     Int      @default(0)
  score     Int      @default(0) // highest score achieved
  rank      String   @default("Explorer")
  accuracy  Float    @default(0.0)
  
  // Serverless Session Tracking
  currentSessionLevel Int @default(0)
  sessionCorrectCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameHistory   GameHistory[]
  achievements  Achievement[]
  leaderboard   Leaderboard?
}

model GameHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  level          Int
  question       String
  selectedAnswer String
  correctAnswer  String
  score          Int
  timeTaken      Int      // in seconds
  date           DateTime @default(now())
}

model Achievement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  badge     String
  earnedAt  DateTime @default(now())
}

model Leaderboard {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @unique @db.ObjectId
  user         User   @relation(fields: [userId], references: [id])
  score        Int    @default(0)
  rank         Int    @default(0)
  weeklyScore  Int    @default(0)
  monthlyScore Int    @default(0)
}
